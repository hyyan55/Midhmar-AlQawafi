# ==========================================
# Frontend Configuration (Vite)
# ==========================================
VITE_APP_NAME="مِضمار القوافي"
# Optional: Backend API URL when running frontend and backend separately (e.g. http://localhost:4000)
VITE_API_BASE_URL=""
# Optional: Vite dev proxy target when running backend locally on port 4000
VITE_API_PROXY_TARGET=""

# ==========================================
# Backend Server Configuration (Optional during UI-only dev)
# ==========================================
APP_NAME="مِضمار القوافي"
NODE_ENV="development"
API_PORT=4000
SERVE_SPA="false"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# ==========================================
# PostgreSQL Connection (Optional until DB stage)
# ==========================================
DATABASE_URL=""
PGHOST=""
PGPORT=5432
PGDATABASE=""
PGUSER=""
PGPASSWORD=""
PGSSL="false"

# ==========================================
# Authentication Secrets (Placeholders only - replace before production)
# ==========================================
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="REPLACE_WITH_RANDOM_REFRESH_SECRET"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# ==========================================
# Qafiyah Dataset Import (Optional until import stage)
# ==========================================
QAFIYAH_DUMP_PATH=""
QAFIYAH_CLEANED_DIR="./database/cleaned"

# Gmail SMTP (use a Google App Password; never commit the password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=midhmar.alqawafi@gmail.com
SMTP_PASS=
EMAIL_FROM=مِضمار القوافي <midhmar.alqawafi@gmail.com>

# Cloudinary profile photo storage (configure these as Render environment variables)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
